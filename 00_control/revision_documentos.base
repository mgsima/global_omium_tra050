      - doc_03_factura
      - formula.fichero_03_factura
      - formula.motivo_03_factura
      - doc_04_permiso_ve
      - formula.fichero_04_permiso_ve
      - formula.motivo_04_permiso_ve
      - doc_05_ft_ve
      - formula.fichero_05_ft_ve
      - formula.motivo_05_ft_ve
      - doc_07_propiedad
