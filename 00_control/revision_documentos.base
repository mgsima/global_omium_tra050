views:
  - type: table
    name: Revisión de documentos
    order:
      - file.name
      - doc_03_factura
      - fichero_03_factura
      - motivo_03_factura
      - doc_04_permiso_ve
      - fichero_04_permiso_ve
      - motivo_04_permiso_ve
      - doc_05_ft_ve
      - fichero_05_ft_ve
      - motivo_05_ft_ve
      - doc_07_propiedad
      - fichero_07_propiedad
      - motivo_07_propiedad
      - doc_08_ft_antiguo
      - fichero_08_ft_antiguo
      - motivo_08_ft_antiguo
      - doc_09_entrega
      - fichero_09_entrega
      - motivo_09_entrega
      - doc_21_dni
      - fichero_21_dni
      - motivo_21_dni
    sort:
      - property: doc_04_permiso_ve
        direction: ASC
      - property: file.name
        direction: DESC
      - property: motivo_03_factura
        direction: ASC
    rowHeight: extra
    columnSize:
      file.name: 160
      note.doc_03_factura: 119
      note.fichero_03_factura: 282
